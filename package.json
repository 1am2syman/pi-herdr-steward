{
  "name": "pi-herdr-steward",
  "version": "0.1.0",
  "description": "A compact Pi extension for inspecting Steward Runs.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "steward"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:journal-recovery": "vitest run test/journal-recovery.functional.test.ts --maxWorkers=1",
    "test:resume": "vitest run test/resume.functional.test.ts test/herdr-reconciliation.contract.test.ts --maxWorkers=1",
    "test:retry": "vitest run test/retry.functional.test.ts test/retry-policy.contract.test.ts test/retry-storage.contract.test.ts test/herdr-retry.contract.test.ts --maxWorkers=1",
    "test:completion": "vitest run test/completion.functional.test.ts",
    "test:cancel-cleanup": "vitest run test/cancel-cleanup.functional.test.ts test/herdr-adapter.contract.test.ts test/completion-storage.contract.test.ts --maxWorkers=1",
    "test:integration-git": "vitest run test/integration-git.contract.test.ts",
    "test:completion-storage": "vitest run test/completion-storage.contract.test.ts",
    "test:process": "vitest run test/process-adapter.contract.test.ts test/process-observer.contract.test.ts",
    "test:final-verification": "vitest run test/final-verification-recovery.functional.test.ts --maxWorkers=1",
    "test:recovery": "vitest run test/recovery.functional.test.ts test/process-observer.contract.test.ts test/herdr-recovery.contract.test.ts --maxWorkers=1",
    "test:evidence": "vitest run test/evidence.functional.test.ts",
    "test:review": "vitest run test/review.functional.test.ts",
    "test:rework": "vitest run test/review.functional.test.ts test/rework.functional.test.ts -t \"ticket-07\"",
    "test:git": "vitest run test/git-evidence.contract.test.ts",
    "test:dispatch": "vitest run test/dispatch.functional.test.ts",
    "test:monitor": "vitest run test/monitor.functional.test.ts --maxWorkers=1",
    "test:ownership": "vitest run test/controller-ownership.functional.test.ts test/controller-ownership.contract.test.ts test/controller-ownership.storage.test.ts --maxWorkers=1",
    "test:herdr": "vitest run test/herdr-adapter.contract.test.ts test/herdr-completion.contract.test.ts test/herdr-monitor.contract.test.ts test/herdr-recovery.contract.test.ts --maxWorkers=1",
    "test:start": "vitest run test/start.functional.test.ts",
    "test:storage": "vitest run test/run-journal.storage.test.ts",
    "test:coordination": "vitest run test/coordination-policy.contract.test.ts test/coordination.functional.test.ts test/multi-task-storage.contract.test.ts --maxWorkers=1",
    "test:revise": "vitest run test/revise.functional.test.ts --maxWorkers=1",
    "test:config": "vitest run test/config.functional.test.ts",
    "test:install-docs": "vitest run test/install-functional-path.static.test.ts --maxWorkers=1",
    "test:install-functional": "node --experimental-strip-types test/install-functional-path.smoke.ts",
    "smoke:herdr-real": "node --experimental-strip-types scripts/smoke-real-herdr.mjs",
    "test": "vitest run --maxWorkers=1"
  }
}
